[Unit]
Description=wxgrid — read-only forecast API + web UI
Documentation=file:/opt/wxgrid/README.md
After=network-online.target
Wants=network-online.target

[Service]
# Shares the wxgrid.slice envelope (30 % CPU / 50 % RAM for everything wxgrid).
Slice=wxgrid.slice
Type=simple
WorkingDirectory=/opt/wxgrid
Environment=PYTHONUNBUFFERED=1
# Bound to 0.0.0.0 on request. The API is READ-ONLY and unauthenticated: anyone
# who can reach this port can read every published forecast. There is nothing
# to write and no secrets in the data dir, but put it behind the reverse proxy
# (TLS + rate limit) before advertising the URL.
ExecStart=/usr/bin/python3 -m wxgrid serve --host 0.0.0.0 --port 8790 --data-dir /var/lib/wxgrid
Restart=on-failure
RestartSec=5s

# It only reads JSON off disk, so it stays tiny.
Nice=10
CPUQuota=25%
MemoryHigh=192M
MemoryMax=384M
TasksMax=64

# Hardening: no writes anywhere, data dir read-only.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/var/lib/wxgrid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
